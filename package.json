{
  "name": "sistema-fabrica",
  "version": "1.0.0",
  "description": "Sistema de gestão de produção para fábrica",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install",
    "render:build": "npm install && cd client && npm install && npm run build && cd .. && node scripts/setup-render.js",
    "migrate:pg": "node scripts/migrate-to-postgres.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
